# ==============================================================================
# MULTI_DOWNLOADER Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your private credentials:
#   copy .env.example .env
#
# The .env file is git-ignored and will NEVER be tracked, uploaded, or leaked.
# Credentials here take precedence over config.json and keep config.json clean.
# ==============================================================================

# ------------------------------------------------------------------------------
# Telegram-dl Credentials
# ------------------------------------------------------------------------------
# Obtain your api_id and api_hash from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ------------------------------------------------------------------------------
# Terabox-dl Credentials
# ------------------------------------------------------------------------------
# ndus cookie extracted from your browser's login session (cookies for terabox.com)
TERABOX_NDUS=
TERABOX_NDUS_COOKIE=
TERABOX_JS_TOKEN=

# ------------------------------------------------------------------------------
# Global Network Proxy (Optional)
# ------------------------------------------------------------------------------
# E.g. http://127.0.0.1:7890 or socks5://127.0.0.1:1080
# GLOBAL_PROXY=
